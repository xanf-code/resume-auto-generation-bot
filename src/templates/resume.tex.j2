\documentclass[11pt]{article}

% ATS-parseable, single-column, standard fonts. No tables, no graphics, no
% multicol anywhere in the experience section. Jinja delimiters are remapped
% by the renderer (expression and logic delimiters) so they never collide with
% LaTeX braces.

\usepackage[margin=0.75in]{geometry}
\usepackage{enumitem}
\usepackage{hyperref}
\usepackage[T1]{fontenc}

\setlist[itemize]{leftmargin=1.5em, itemsep=1pt, topsep=2pt}
\pagenumbering{gobble}
\setlength{\parindent}{0pt}

\newcommand{\resumesection}[1]{%
  \vspace{6pt}%
  {\large\bfseries #1}\par%
  \vspace{2pt}\hrule\vspace{4pt}%
}

\begin{document}

% ---------- Header ----------
{\Huge\bfseries \VAR{name}}\par
\vspace{2pt}
\VAR{contact}\par

% ---------- Summary ----------
\resumesection{Summary}
\VAR{summary}\par

% ---------- Skills ----------
\resumesection{Skills}
\VAR{skills | join(" \\textbullet\\ ")}\par

% ---------- Experience ----------
\resumesection{Experience}
\BLOCK{for role in experience}
\VAR{role_header_marker}
{\bfseries \VAR{role.company}} \hfill \VAR{role.start} -- \VAR{role.end}\par
{\itshape \VAR{role.title}}\par
\BLOCK{if role.bullets}
\begin{itemize}
\BLOCK{for bullet in role.bullets}
  \item \VAR{bullet}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endif}
\vspace{4pt}
\BLOCK{endfor}

% ---------- Education ----------
\resumesection{Education}
\BLOCK{for line in education}
\VAR{line}\par
\BLOCK{else}
\VAR{no_education_placeholder}\par
\BLOCK{endfor}

\end{document}
